{
  "manifest_version": 2,
  "name": "Tab Recall",
  "version": "1.1.0",
  "description": "Keyboard-driven tab search for Firefox. Search, switch, close, and deduplicate open tabs instantly.",
  "homepage_url": "https://github.com/fcjreed/tab-search-extension",
  "browser_specific_settings": {
    "gecko": {
      "id": "tab-search@vedavox",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["tabs"],
  "commands": {
    "toggle-tab-search": {
      "suggested_key": {
        "default": "Ctrl+Space"
      },
      "description": "Open tab search"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  }
}
